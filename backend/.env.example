# Copy this file to ".env" and adjust if needed.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mart_management
SESSION_SECRET=change-this-to-a-long-random-string
# Comma separated list of frontend origins allowed to call the API (with cookies)
CLIENT_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
